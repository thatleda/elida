---
import type { Locale } from '../i18n'
import { path, stripLocale, useTranslations } from '../i18n'
import { localeNames, locales } from '../i18n/config'

interface Props {
  lang: Locale
}

const { lang } = Astro.props
const t = useTranslations(lang)

const here = stripLocale(Astro.url.pathname).replace(/\/$/, '') || '/'

const nav = [
  { href: path('/#who', lang), label: t('nav.who') },
  { href: path('/#previously', lang), label: t('nav.previously') },
  { href: path('/ramblings', lang), label: t('nav.blog'), match: '/ramblings' },
  { href: path('/#reviews', lang), label: t('nav.working-with') },
  { href: path('/#contact', lang), label: t('nav.contact') },
  { href: path('/resume', lang), label: t('nav.resume'), match: '/resume' },
];
---

<header class="site-header">
  <a class="wordmark" href={path('/', lang)} aria-label="ELIDA — home">
    <span aria-hidden="true">&gt;</span> ELIDA
  </a>

  <nav aria-label={t('nav.menu')}>
    <ul>
      {
        nav.map(item => (
          <li>
            <a
              href={item.href}
              aria-current={item.match && here.startsWith(item.match) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="controls">
    <div class="lang" role="group" aria-label={t('nav.language')}>
      {
        locales.map(locale => (
          <a
            href={path(here, locale)}
            lang={locale}
            hreflang={locale}
            aria-current={locale === lang ? 'true' : undefined}
          >
            {locale.toUpperCase()}
            <span class="visually-hidden"> — {localeNames[locale]}</span>
          </a>
        ))
      }
    </div>

    <button type="button" id="theme-toggle" aria-pressed="false">
      <span aria-hidden="true">◐</span>
      <span class="visually-hidden">{t('nav.toggle.color-mode')}</span>
    </button>
  </div>
</header>

<script is:inline>
(() => {
  const btn = document.getElementById('theme-toggle')
  if (!btn)
    return
  const root = document.documentElement
  const sync = () => {
    const isLight = root.dataset.theme === 'light'
    btn.setAttribute('aria-pressed', String(isLight))
  }
  sync()
  btn.addEventListener('click', () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light'
    root.dataset.theme = next
    try {
      localStorage.setItem('elida-theme', next)
    }
    catch {}
    sync()
  })
})()
</script>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    max-width: 68rem;
    margin: 0 auto;
    padding: 1.25rem clamp(1rem, 4vw, 2.5rem);
    border-bottom: var(--border-width) solid var(--border);
  }

  .wordmark {
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: 0.12em;
    border: 0;
    color: var(--fg-bright);
  }

  .wordmark:hover,
  .wordmark:focus-visible {
    background: none;
    color: var(--fg-bright);
  }

  nav {
    flex: 1 1 auto;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    border-bottom-width: 1px;
  }

  nav a[aria-current='page'] {
    background: var(--fg);
    color: var(--bg);
  }

  .controls {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .lang {
    display: flex;
    gap: 0.5rem;
  }

  .lang a {
    border: 0;
    color: var(--fg-dim);
    font-size: 0.85rem;
  }

  .lang a[aria-current='true'] {
    color: var(--fg-bright);
    text-decoration: underline;
  }

  #theme-toggle {
    background: var(--bg-raised);
    color: var(--fg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.3rem 0.55rem;
    font: inherit;
    cursor: pointer;
    line-height: 1;
  }

  #theme-toggle:hover {
    background: var(--fg);
    color: var(--bg);
  }
</style>
