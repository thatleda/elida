---
import type { Locale } from '../i18n'
import Base from '../layouts/Base.astro'
import { getPage } from '../lib/sanity'
import Prose from './Prose.astro'

interface Props {
  lang: Locale
  slug: string
}

const { lang, slug } = Astro.props
const page = await getPage(slug, lang)

if (!page) {
  return new Response(null, { status: 404 })
}
---

<Base lang={lang} title={`ELIDA — ${page.title}`} description={page.excerpt}>
  <article class="panel">
    <p class="prompt"><span aria-hidden="true">&gt;</span> cat ~/{slug}.txt</p>
    <h1>{page.title}</h1>
    <Prose blocks={page.content} />
  </article>
</Base>

<style>
  .prompt {
    color: var(--fg-dim);
    margin-top: 0;
  }
</style>
