---
import type { Locale } from '../i18n'
import { path, useTranslations } from '../i18n'

interface Props {
  lang: Locale
}

const { lang } = Astro.props
const t = useTranslations(lang)
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell">
    <p>
      <span aria-hidden="true">&gt;</span>
      {year} — Leda Wolf. ELIZA&#8209;adjacent vanity.
    </p>
    <nav aria-label="Legal">
      <a href={path('/privacy', lang)}>{t('footer.privacy')}</a>
      <a href={path('/imprint', lang)}>{t('footer.imprint')}</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    border-top: var(--border-width) solid var(--border);
    color: var(--fg-dim);
    font-size: 0.85rem;
  }

  .site-footer .shell {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-block: 1.5rem;
  }

  .site-footer p {
    margin: 0;
  }

  .site-footer nav {
    display: flex;
    gap: 1rem;
  }
</style>
