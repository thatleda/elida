---
import type { Locale } from '../i18n'
import { useTranslations } from '../i18n'
import Base from '../layouts/Base.astro'
import { renderBlocks } from '../lib/portableText'
import { getPage, getReviews } from '../lib/sanity'
import EliQuery from './EliQuery.vue'
import Prose from './Prose.astro'
import ReadingNow from './ReadingNow.astro'
import SanityImage from './SanityImage.astro'
import Section from './Section.astro'
import StoryBeats from './StoryBeats.vue'
import TypedCommand from './TypedCommand.astro'

interface Props {
  lang: Locale
}

const { lang } = Astro.props
const t = useTranslations(lang)

const [hero, who, adventure, reviews] = await Promise.all([
  getPage('hero', lang),
  getPage('who', lang),
  getPage('adventure', lang),
  getReviews(),
])

const title = 'ELIDA'
const description = hero?.excerpt ?? t('hero.tagline')
const contactEmail = 'leda@sent.com'

const beats
  = adventure?.beats?.map(beat =>
    renderBlocks(beat.content, { images: false }),
  ) ?? [];
---

<Base lang={lang} title={title} description={description}>
  <section class="hero panel">
    <div class="hero-text">
      <h1>{hero?.title ?? 'Leda Wolf'}</h1>
      <p class="tagline">{t('hero.tagline')}</p>
      <p class="pitch" set:html={t('hero.pitch')} />
      {hero?.content && <Prose blocks={hero.content} />}
      <EliQuery
        client:idle
        lang={lang}
        prompt={t('eli.prompt')}
        placeholder={t('eli.placeholder')}
      />
    </div>
    {
      hero?.banner && (
        <SanityImage
          image={hero.banner}
          eager
          widths={[240, 360, 480]}
          sizes="(max-width: 40rem) 40vw, 240px"
          class="hero-portrait"
        />
      )
    }
  </section>

  {
    who && (
      <Section id="who" heading={t('section.who')}>
        <div class="who-grid">
          {who.banner && (
            <SanityImage
              image={who.banner}
              widths={[240, 360, 480]}
              sizes="(max-width: 40rem) 40vw, 220px"
              class="who-portrait"
            />
          )}
          <Prose blocks={who.content} />
        </div>
      </Section>
    )
  }

  {
    adventure && (
      <Section
        id="previously"
        heading={adventure.title || t('section.previously')}
      >
        {beats.length > 0
? (
          <StoryBeats
            client:visible
            beats={beats}
            nextLabel={t('previously.next')}
            fullLabel={t('previously.full')}
          />
        )
: (
          <Prose blocks={adventure.content} />
        )}
      </Section>
    )
  }

  {
    reviews.length > 0 && (
      <Section id="reviews" heading={t('section.reviews')}>
        <ul class="reviews">
          {reviews.map(review => (
            <li>
              {review.picture && (
                <SanityImage
                  image={review.picture}
                  alt={`Photo of ${review.reviewer}`}
                  widths={[80, 160]}
                  sizes="72px"
                  class="avatar"
                />
              )}
              <div>
                <blockquote>{review.comment}</blockquote>
                <p class="reviewer">— {review.reviewer}</p>
              </div>
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  <Section id="status">
    <TypedCommand word="status" class="prompt" />
    <ReadingNow lang={lang} />
  </Section>

  <Section id="contact">
    <TypedCommand word="link" class="prompt" />
    <p>{t('contact.leda')}</p>
    <p class="contact-email">
      <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
    </p>
    <p>{t('contact.links')}:</p>
    <p>
      <div class="contact-links-wrapper">
        <ul class="contact-links">
          <li>
            <a
              href="https://calendly.com/ledawolf/meeting"
              target="_blank"
              rel="noopener noreferrer"
            >{t('contact.calendly')}</a
            >
          </li>
          <li>
            <a
              href="https://github.com/thatleda"
              target="_blank"
              rel="noopener noreferrer"
            >GitHub</a
            >
          </li>
          <li>
            <a
              href="https://www.linkedin.com/in/thatleda/"
              target="_blank"
              rel="noopener noreferrer"
            >LinkedIn</a
            >
          </li>
          <li>
            <a
              href="https://discord.com/users/732667625255075951"
              target="_blank"
              rel="noopener noreferrer"
            >Discord
            </a>
          </li>
        </ul>
      </div>
    </p>
  </Section>
</Base>

<style>
  .hero {
    display: flex;
    flex-wrap: wrap-reverse;
    gap: 1.5rem 2rem;
    align-items: start;
  }

  .hero-text {
    flex: 1 1 20rem;
  }

  .hero .prompt {
    color: var(--fg-dim);
    margin-top: 0;
  }

  .hero h1 {
    margin: 0.3rem 0;
  }

  .hero :global(.hero-portrait) {
    flex: 0 0 auto;
    width: clamp(9rem, 30%, 14rem);
  }

  .tagline {
    font-size: 1.1rem;
  }

  .who-grid {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 40rem) {
    .who-grid {
      grid-template-columns: 13rem 1fr;
      align-items: start;
    }
  }

  .reviews {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }

  .reviews li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: start;
  }

  .reviews :global(.avatar) {
    width: 3rem;
    height: 3rem;
    object-fit: cover;
    border-radius: 50%;
  }

  .reviews blockquote {
    margin: 0;
    padding-left: 1rem;
    border-left: 2px solid var(--border);
  }

  .reviewer {
    color: var(--fg-dim);
    margin: 0.4rem 0 0;
  }

  .contact-email {
    text-align: center;
  }

  .contact-links-wrapper {
    display: flex;
    justify-content: end;
  }

  .contact-links {
    display: flex;
    flex-direction: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
  }
</style>
