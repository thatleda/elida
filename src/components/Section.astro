---
interface Props {
  id?: string;
  heading?: string;
  headingLevel?: 2 | 3;
}

const { id, heading, headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}` as const;
---

<section id={id} class="panel" aria-labelledby={id && heading ? `${id}-title` : undefined}>
  {heading && <Heading id={id ? `${id}-title` : undefined}>{heading}</Heading>}
  <slot />
</section>
